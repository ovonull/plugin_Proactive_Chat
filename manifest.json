{
  "manifest_version": 1,
  "id": "cn.ucbk.proactive_chat",
  "name": "主动消息",
  "version": "1.2.3",
  "description": "基于会话沉默时长的主动发言机制。达到触发阈值后，经开口适宜性评估与概率采样决定是否生成并发送消息；连续主动未获响应达到上限即进入暂停态，待用户发言后复位。",
  "author": {
    "name": "UCBK",
    "url": "https://www.ucbk.cn"
  },
  "license": "MIT",
  "entry": "plugin.py",
  "category": "entertainment",
  "capabilities": [
    "msg.send",
    "msg.history",
    "llm.generate",
    "plugin.storage",
    "scheduler.register",
    "cache.kv"
  ],
  "config_schema": [
    {
      "key": "silence_minutes",
      "label": "沉默触发阈值（分钟，1～1440）",
      "type": "number",
      "default": 10,
      "required": false,
      "sensitive": false
    },
    {
      "key": "max_unanswered",
      "label": "未响应次数上限（1～20，达到后暂停主动）",
      "type": "number",
      "default": 3,
      "required": false,
      "sensitive": false
    },
    {
      "key": "tick_seconds",
      "label": "巡检周期（秒，最小 10）",
      "type": "number",
      "default": 30,
      "required": false,
      "sensitive": false
    },
    {
      "key": "score_enabled",
      "label": "群聊开口前评分（私聊豁免，仅按概率触发）",
      "type": "switch",
      "default": true,
      "required": false,
      "sensitive": false
    },
    {
      "key": "speak_probability",
      "label": "插话概率（0～1，评分通过后的触发概率）",
      "type": "number",
      "default": 0.4,
      "required": false,
      "sensitive": false
    },
    {
      "key": "group_chat_enabled",
      "label": "群聊主动发言",
      "type": "switch",
      "default": true,
      "required": false,
      "sensitive": false
    },
    {
      "key": "friend_chat_enabled",
      "label": "私聊主动发言",
      "type": "switch",
      "default": true,
      "required": false,
      "sensitive": false
    },
    {
      "key": "history_limit",
      "label": "历史上下文条数（1～30，用于生成参考）",
      "type": "number",
      "default": 12,
      "required": false,
      "sensitive": false
    },
    {
      "key": "quiet_hours_enabled",
      "label": "启用免打扰时段",
      "type": "switch",
      "default": true,
      "required": false,
      "sensitive": false
    },
    {
      "key": "quiet_hours",
      "label": "免打扰时段（24 小时制，如 23:00-07:00）",
      "type": "text",
      "default": "23:00-07:00",
      "required": false,
      "sensitive": false
    },
    {
      "key": "group_motivation",
      "label": "群聊发言动机提示词",
      "type": "textarea",
      "default": "",
      "required": false,
      "sensitive": false
    },
    {
      "key": "friend_motivation",
      "label": "私聊发言动机提示词",
      "type": "textarea",
      "default": "",
      "required": false,
      "sensitive": false
    }
  ]
}
